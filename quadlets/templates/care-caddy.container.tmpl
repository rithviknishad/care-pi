# {{.Header}}
# Caddy: TLS, routing, the FE build, plug bundles, and status pages.
# It does not wait for the clock gate, so it can show the clock status page.
# It sends the console and the public agent operations to the agent socket in {{path "RunDir"}}.
# It starts after {{.AgentUnit}}, but does not need it: without the agent, the agent routes give 503.

[Unit]
Description=care-pi Caddy (TLS and routing)
PartOf=care.target
Wants={{.AgentUnit}}
After={{.AgentUnit}}

[Container]
ContainerName=care-caddy
Image={{.Images.caddy}}
Pod=care.pod
RunInit=true
Exec=caddy run --config /etc/caddy/Caddyfile --adapter caddyfile
Volume={{path "RenderedCaddy"}}:/etc/caddy:ro
Volume={{path "CaddyData"}}:/data
Volume={{path "FEDir"}}:/srv/fe:ro
Volume={{path "PlugsDir"}}:/srv/plugs:ro
Volume={{path "ModeDir"}}:/srv/mode:ro
# A directory, not the socket file: the agent makes a new socket at each start.
Volume={{path "RunDir"}}:{{path "RunDir"}}
{{- if .CARoot}}
# The name-constrained root of the agent (docs/connectivity.md). Read only.
Volume={{path "CADir"}}:{{path "CACaddyDir"}}:ro
{{- end}}
{{- if .ACMEDNSSecret}}
# The credentials of the acmedns module (public mode), as a file: {{.ACMEDNSFile}}.
Secret={{.ACMEDNSSecret}},type=mount,mode=0400
{{- end}}
{{- if .PublicACMECA}}
# The ACME directory of the public name. A change of it restarts care-caddy: a reload keeps the certificate of the old
# directory in the cache of Caddy, and Caddy then asks the new directory for nothing.
Label=care-pi.acme-ca={{.PublicACMECA}}
{{- end}}
{{- if .TailscaleHost}}
# The socket of tailscaled: Caddy gets the certificate of {{.TailscaleHost}} through it.
Volume={{.TailscaleSocketDir}}:{{.TailscaleSocketDir}}
{{- end}}

[Service]
# The bind mount needs the directory, also when the agent does not run.
ExecStartPre=/bin/mkdir -p {{path "RunDir"}}
{{- if .TailscaleHost}}
ExecStartPre=/bin/mkdir -p {{.TailscaleSocketDir}}
{{- end}}
MemoryMax={{.MemCad.Max}}
MemorySwapMax={{.MemCad.Swap}}
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=care.target
