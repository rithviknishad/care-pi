{{template "status-head-live" .}}
<title>CARE: maintenance</title>
</head>
<body>
<main>
<h1>CARE is in maintenance</h1>
<p class="name">{{html .DisplayName}}</p>
<p>The device updates or restarts CARE. Your data is safe.</p>
<p id="step" aria-live="polite">Wait a few minutes. This page opens CARE again when the maintenance is complete.</p>
<p><small id="since"></small></p>
<p><small id="internet"></small></p>
{{template "status-job" .}}
<p><small>This page checks the device every 5 seconds.</small></p>
</main>
<script>
{{template "status-job-script" .}}
(function () {
  // A restart of care-api behind this page (S62): the step restart.
  var restart = {{printf "%q" .MaintenanceRestart}};
  function show(m) {
    var step = document.getElementById("step"), since = document.getElementById("since");
    if (m && m.active) {
      step.textContent = (m.step === "restart" && restart) || (m.step && carePiJob.sentence(m.step)) || "Wait a few minutes. This page opens CARE again when the maintenance is complete.";
      if (m.started_at) {
        var t = new Date(m.started_at);
        since.textContent = "Maintenance since " + t.toLocaleTimeString() + ".";
      }
    } else if (m) {
      step.textContent = "The maintenance is complete. This page opens CARE in a few seconds.";
      since.textContent = "";
    }
  }
  function poll() {
    fetch("/_care-pi/status", {cache: "no-store", headers: {"Accept": "application/json"}})
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (s) {
        if (!s) { return; }
        if (s.site === "care") { window.location.reload(); return; }
        show(s.maintenance);
        document.getElementById("internet").textContent = carePiInternet(s);
        carePiJob.update(s);
      })
      .catch(function () {})
      .then(function () { setTimeout(poll, 5000); });
  }
  poll();
})();
</script>
</body>
</html>
