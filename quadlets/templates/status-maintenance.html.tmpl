{{template "status-head" .}}
<title>CARE: maintenance</title>
</head>
<body>
<main>
<h1>CARE is in maintenance</h1>
<p class="name">{{html .DisplayName}}</p>
<p>The device updates or restarts CARE. Your data is safe.</p>
<p>Wait a few minutes. This page opens CARE again when the maintenance is complete.</p>
<p><small>This page refreshes every 15 seconds.</small></p>
</main>
</body>
</html>
