{{template "status-head" .}}
<title>CARE: clock check</title>
</head>
<body>
<main>
<h1>CARE waits for a correct time</h1>
<p class="name">{{html .DisplayName}}</p>
<p>CARE starts only when the clock of this device is correct. Records with a wrong time cause errors.</p>
<p>Connect the device to a network with internet access. The device then sets its clock and starts CARE.</p>
<p id="internet"></p>
<p><small>This page refreshes every 15 seconds.</small></p>
</main>
<script>
{{template "status-internet-fn"}}
fetch("/_care-pi/status", {cache: "no-store", headers: {"Accept": "application/json"}})
  .then(function (r) { return r.ok ? r.json() : null; })
  .then(function (s) { if (s) { document.getElementById("internet").textContent = carePiInternet(s); } })
  .catch(function () {});
</script>
</body>
</html>
