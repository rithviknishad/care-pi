# {{.Header}}
# One local encrypted repository (S40). restic copies it to the backup destinations.
# The cipher pass comes from the environment variable PGBACKREST_REPO1_CIPHER_PASS (podman secret).

[global]
process-max=1
compress-type=zst
compress-level=3
start-fast=y
archive-async=y
spool-path=/var/spool/pgbackrest
log-path=/var/log/pgbackrest
log-level-console=info
log-level-file=detail
delta=y

repo1-type=posix
repo1-path=/var/lib/pgbackrest
repo1-retention-full={{.PGRetentionFull}}
repo1-retention-diff=7
repo1-cipher-type=aes-256-cbc
repo1-bundle=y
repo1-block=y

[{{.Stanza}}]
pg1-path=/var/lib/postgresql/data
pg1-socket-path=/var/run/postgresql
pg1-user={{.DB.User}}
