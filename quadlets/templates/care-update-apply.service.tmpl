# {{.Header}}
# The work of the update window: the Care update (updates.auto), the OS upgrade (updates.os_full),
# and the reboot (updates.os_reboot). The command stops at once when the window is closed.
# No start timeout: a timeout would stop a cutover in the middle. The job starts a cutover only while
# 10 minutes of the window remain. A stop (SIGTERM) runs the rollback of a cutover, or holds the OS
# packages again; TimeoutStopSec gives it the time.

[Unit]
Description=care-pi update window work
After=network-online.target care-pi.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart={{path "Binary"}} update apply --scheduled
TimeoutStartSec=infinity
TimeoutStopSec=15min
