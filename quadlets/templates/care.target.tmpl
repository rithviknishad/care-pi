# {{.Header}}
# No [Install] section: care-start.service starts this target at boot without a wait.
{{- if .Bootstrap}}
# Setup mode runs only the pod and Caddy. They do not wait for the clock gate, so the target does not
# wait for it either: the setup works before the clock is synchronized (a first boot without internet).
{{- end}}

[Unit]
Description=CARE on care-pi
Documentation=https://github.com/rithviknishad/care-pi
{{- if not .Bootstrap}}
Requires=care-clock.service
After=care-clock.service
{{- end}}
Wants={{join .Units " "}}
