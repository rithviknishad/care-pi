#!/bin/bash
# {{.Header}}
# Build care_fe at CARE_FE_SHA and copy the output to OUT.
# care-fe-build.service runs this script in the node container (fe.provider: local).
# The fe-bundle workflow runs the same script on a CI runner.
# The recipe is the recipe of spike SP4. See docs/fe.md.
#
# Inputs (environment):
#   CARE_FE_SHA   the full commit sha of care_fe (required)
#   BUILD_ID      the FE build id (required)
#   CARE_FE_REPO  the GitHub repository, default ohcnetwork/care_fe
#   SRC           the source directory, default /build/src (node_modules stays here)
#   CACHE         the npm cache, default /build/npm-cache
#   OUT           the output directory, default /out/BUILD_ID
#   ENV_FILE      the frontend env file, default /build/env/frontend.env
set -euo pipefail

: "${CARE_FE_SHA:?set CARE_FE_SHA to the full commit sha of care_fe}"
: "${BUILD_ID:?set BUILD_ID to the FE build id}"
CARE_FE_REPO="${CARE_FE_REPO:-ohcnetwork/care_fe}"
SRC="${SRC:-/build/src}"
CACHE="${CACHE:-/build/npm-cache}"
OUT="${OUT:-/out/${BUILD_ID}}"
ENV_FILE="${ENV_FILE:-/build/env/frontend.env}"

fail() {
  echo "care-pi: $*" >&2
  exit 1
}

[[ "$CARE_FE_SHA" =~ ^[0-9a-f]{40}$ ]] || fail "CARE_FE_SHA must be a full commit sha: ${CARE_FE_SHA}"
[[ "$BUILD_ID" =~ ^[A-Za-z0-9_-]+$ ]] || fail "BUILD_ID has a bad character: ${BUILD_ID}"
[[ "$CARE_FE_REPO" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || fail "CARE_FE_REPO must be OWNER/NAME: ${CARE_FE_REPO}"
[ -f "$ENV_FILE" ] || fail "the env file ${ENV_FILE} does not exist"

export CI=true HUSKY=0 npm_config_cache="$CACHE" npm_config_update_notifier=false
# The vite 8 (rolldown) build is mostly native memory. The heap limit does not bound it (SP4).
export NODE_OPTIONS="${NODE_OPTIONS:---max-old-space-size=1024}"

started=$(date +%s)
mark=$started
took() {
  local now
  now=$(date +%s)
  echo "care-pi: $1: $((now - mark)) s"
  mark=$now
}

# Download a URL to stdout. The node image has no curl, so use the fetch of Node.
fetch() {
  node -e '
const { Readable } = require("node:stream");
const { pipeline } = require("node:stream/promises");
const url = process.argv[1];
(async () => {
  const res = await fetch(url, { headers: { "User-Agent": "care-pi-fe-build" } });
  if (!res.ok) throw new Error("HTTP " + res.status + " for " + url);
  await pipeline(Readable.fromWeb(res.body), process.stdout);
})().catch((err) => {
  console.error("care-pi: " + err.message);
  process.exit(1);
});
' "$1"
}

# 1. The source. Fetch the tarball only when the sha changed. Keep node_modules.
mkdir -p "$SRC" "$CACHE"
if [ "$(cat "$SRC/.care-pi-sha" 2>/dev/null || true)" != "$CARE_FE_SHA" ]; then
  url="https://codeload.github.com/${CARE_FE_REPO}/tar.gz/${CARE_FE_SHA}"
  echo "care-pi: fetch ${url}"
  find "$SRC" -mindepth 1 -maxdepth 1 ! -name node_modules ! -name .care-pi-lock-hash -exec rm -rf {} +
  fetch "$url" | tar -xz -C "$SRC" --strip-components=1
  echo "$CARE_FE_SHA" >"$SRC/.care-pi-sha"
  took "fetch"
else
  echo "care-pi: the source of ${CARE_FE_SHA} is present; no fetch"
fi
cd "$SRC"

# 2. The dependencies. npm ci when package-lock.json changed, else npm install (seconds).
# npm install can rewrite package-lock.json. Then the next build of the same source sees a
# different hash and runs npm ci again (wave 3 on lumine). Thus keep the lock file of the
# source, and start each build from it.
[ -f .care-pi-package-lock.json ] || cp package-lock.json .care-pi-package-lock.json
cp .care-pi-package-lock.json package-lock.json
lock_hash=$(sha256sum package-lock.json | cut -d' ' -f1)
if [ -d node_modules ] && [ "$(cat .care-pi-lock-hash 2>/dev/null || true)" = "$lock_hash" ]; then
  echo "care-pi: package-lock.json did not change; npm install"
  npm install --no-audit --no-fund --prefer-offline
else
  echo "care-pi: package-lock.json changed; npm ci"
  rm -f .care-pi-lock-hash
  npm ci --no-audit --no-fund --prefer-offline
  echo "$lock_hash" >.care-pi-lock-hash
fi
took "npm"

# 3. The build env. Each line of the env file is NAME=value. The value is literal.
while IFS= read -r name; do
  unset "$name"
done < <(compgen -e | grep '^REACT_' || true)
keys=()
while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in
    '' | '#'*) continue ;;
  esac
  name="${line%%=*}"
  if [ "$name" = "$line" ] || [[ ! "$name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
    fail "${ENV_FILE}: a line is not NAME=value"
  fi
  export "${name}=${line#*=}"
  keys+=("$name")
done <"$ENV_FILE"
[ -n "${REACT_CARE_API_URL+set}" ] || fail "${ENV_FILE} must set REACT_CARE_API_URL (empty for the same origin)"
echo "care-pi: build env: ${keys[*]}"

# 4. The build. Sourcemaps are off: 13 MB instead of 45 MB, and less memory (SP4).
has_script() {
  node -e 'const s = require("./package.json").scripts || {}; process.exit(s[process.argv[1]] ? 0 : 1)' "$1"
}
rm -rf build
if has_script build:meta; then npm run build:meta; fi
if has_script supported-browsers; then npm run supported-browsers; fi
if has_script build:react; then
  npm run build:react -- --sourcemap false
else
  NODE_ENV=production npx vite build --sourcemap false
fi
if has_script postbuild; then npm run postbuild; fi
[ -f build/index.html ] || fail "the build has no index.html"
took "build"

# 5. The output. Copy to OUT.tmp, then rename, so OUT is complete or absent.
mkdir -p "$(dirname "$OUT")"
rm -rf "${OUT}.tmp"
cp -a build "${OUT}.tmp"
{
  printf '{"build_id":"%s","care_fe_repo":"%s","care_fe_sha":"%s","built_at":"%s","env_keys":[' \
    "$BUILD_ID" "$CARE_FE_REPO" "$CARE_FE_SHA" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  sep=""
  for name in "${keys[@]}"; do
    printf '%s"%s"' "$sep" "$name"
    sep=","
  done
  printf ']}\n'
} >"${OUT}.tmp/care-pi-build.json"
rm -rf "$OUT"
mv "${OUT}.tmp" "$OUT"
took "copy"
echo "care-pi: build ${BUILD_ID} is ready in ${OUT}: $(du -sh "$OUT" | cut -f1), $(($(date +%s) - started)) s in total"
