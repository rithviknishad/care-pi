# {{.Header}}
# {{.FirewallUnit}} (the installer writes the unit) loads the table of the agent instead of the file of the
# installer: the table follows config.yaml (security.firewall, security.ssh, tls.tailscale). The plan action
# reload-firewall reloads the unit after a change. Without the unit (install.sh --no-firewall, or ufw or firewalld),
# this file does nothing.

# A start (the boot) first runs "care-pi firewall boot-check": a policy drop that waited for its confirmation goes
# back to accept, so the boot loads the confirmed table. The "-" keeps the load when the check fails.

[Service]
ExecStartPre=-{{path "Binary"}} firewall boot-check
ExecStart=
ExecStart=/usr/sbin/nft -f {{.FirewallFile}}
ExecReload=
ExecReload=/usr/sbin/nft -f {{.FirewallFile}}
