# {{.Header}}
# The Tailscale mode (tls.tailscale): care-caddy bind-mounts {{.TailscaleSocketDir}}, the directory of the socket of
# tailscaled, and gets the certificate of {{.TailscaleHost}} through it. Without this setting, systemd deletes the
# directory when tailscaled stops (a restart, an apt upgrade of tailscale) and makes a new one at the start; the mount
# of care-caddy then keeps the deleted directory, and each TLS handshake of the Tailscale name fails until care-caddy
# restarts. The setting changes nothing else of tailscaled; apply runs only daemon-reload.

[Service]
RuntimeDirectoryPreserve=yes
