{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rithviknishad/care-pi/blob/main/solutions/schema/lock.schema.json",
  "title": "care-pi solution lock",
  "description": "A solution lock pins each component of one solution to an immutable identity: image digests, git shas, and the SHA-256 of each bundle. CI writes one lock for each release (solutions/<name>/locks/<YYYY.MM.N>.lock.yaml, and the release asset <name>-<YYYY.MM.N>.lock.yaml of the release lock-<name>-<YYYY.MM.N>). A lock never changes after its release. docs/solutions.md, section 3, describes each field. This is not the on-device /etc/care-pi/lock.yaml (docs/solutions.md, section 6).",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "name", "version", "created_at", "created_by", "notes", "min_agent_version", "source", "solution", "care", "solution_image", "care_fe", "fe", "plugs", "images"],
  "properties": {
    "apiVersion": {
      "description": "The version of this format. The only value is care-pi/v1.",
      "const": "care-pi/v1"
    },
    "kind": {
      "description": "The kind of object. The only value is SolutionLock.",
      "const": "SolutionLock"
    },
    "name": {
      "description": "The solution name. It equals solution.name.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 40
    },
    "version": {
      "description": "The calendar version of the lock: YYYY.MM.N. MM has two digits. N starts at 0 in each month.",
      "$ref": "#/$defs/lockVersion"
    },
    "created_at": {
      "description": "The time when CI wrote the lock (UTC).",
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "description": "The person or the workflow run that released the lock.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "notes": {
      "description": "The release notes (Markdown). The release lock-<name>-<version> shows the same text. It can be empty.",
      "type": "string",
      "maxLength": 20000
    },
    "min_agent_version": {
      "description": "The oldest agent that can install this lock. An older agent refuses it with the problem agent-too-old.",
      "$ref": "#/$defs/semver"
    },
    "source": {
      "description": "Where the lock comes from.",
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "solution_sha256", "run_url"],
      "properties": {
        "commit": {
          "description": "The care-pi git commit of solution.yaml.",
          "$ref": "#/$defs/gitSha"
        },
        "solution_sha256": {
          "description": "The SHA-256 of solutions/<name>/solution.yaml at that commit.",
          "$ref": "#/$defs/sha256"
        },
        "run_url": {
          "description": "The CI run that made the artefacts. null for a lock that a person wrote.",
          "type": ["string", "null"],
          "format": "uri"
        }
      }
    },
    "solution": {
      "description": "The solution.yaml document at source.commit, as data. The agent reads the plugs, labels, settings, env, and defaults of the lock from here, not from its embedded copy. Thus a lock that is newer than the agent shows the correct forms.",
      "$ref": "solution.schema.json"
    },
    "care": {
      "description": "The upstream CARE image. The solution image is built FROM image@digest.",
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "ref", "digest", "git_sha"],
      "properties": {
        "image": {
          "description": "The image name without a tag, for example ghcr.io/ohcnetwork/care.",
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "description": "The tag or digest that solution.care.ref asked for.",
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "description": "The manifest list digest that CI resolved.",
          "$ref": "#/$defs/digest"
        },
        "git_sha": {
          "description": "The label org.opencontainers.image.revision of the image. null when the image has no such label.",
          "oneOf": [{ "$ref": "#/$defs/gitSha" }, { "type": "null" }]
        }
      }
    },
    "solution_image": {
      "description": "The image that care-api, care-worker, and care-beat run: the upstream image plus the backend part of each plug of the solution.",
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "tag", "digest", "installed_plugs"],
      "properties": {
        "image": {
          "description": "The image name without a tag.",
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "description": "The tag: <name>-<version>.",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-[0-9]{4}\\.(0[1-9]|1[0-2])\\.[0-9]+$"
        },
        "digest": {
          "description": "The manifest list digest (linux/arm64 and linux/amd64).",
          "$ref": "#/$defs/digest"
        },
        "installed_plugs": {
          "description": "The ids of the plugs whose backend part is installed in the image: each plug of the solution with a backend part, on or off. ADDITIONAL_PLUGS at run time lists only the plugs that are on.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/plugId" }
        }
      }
    },
    "care_fe": {
      "description": "The CARE frontend source.",
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "ref", "sha"],
      "properties": {
        "repo": {
          "description": "The https URL of the repository.",
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "ref": {
          "description": "The branch, tag, or sha that solution.care_fe.ref asked for.",
          "type": "string",
          "minLength": 1
        },
        "sha": {
          "description": "The resolved commit.",
          "$ref": "#/$defs/gitSha"
        }
      }
    },
    "fe": {
      "description": "The default care_fe bundle of the solution: care_fe at care_fe.sha, built with the default frontend env of the solution (docs/fe.md). A device with the same FE build id downloads this bundle.",
      "type": "object",
      "additionalProperties": false,
      "required": ["build_id", "url", "sha256", "size_bytes", "env_keys"],
      "properties": {
        "build_id": {
          "description": "The FE build id (docs/fe.md, \"Build id\").",
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "url": {
          "description": "The bundle (tar.gz). A relative reference resolves against dist_base of index.json.",
          "$ref": "#/$defs/artefactUrl"
        },
        "sha256": {
          "description": "The SHA-256 of the bundle file.",
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "description": "The size of the bundle file.",
          "type": "integer",
          "minimum": 1
        },
        "env_keys": {
          "description": "The names of the frontend variables of the build, sorted. No values.",
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
        }
      }
    },
    "plugs": {
      "description": "The resolved parts of each plug of the solution, by plug id. Each plug of solution.plugs has an entry, on or off.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/plugId" },
      "additionalProperties": { "$ref": "#/$defs/plugLock" }
    },
    "images": {
      "description": "The other images of the stack, by image key. A later lock can add a key.",
      "type": "object",
      "required": ["postgres", "caddy", "redis", "s3", "node"],
      "properties": {
        "postgres": { "$ref": "#/$defs/imageLock" },
        "caddy": { "$ref": "#/$defs/imageLock" },
        "redis": { "$ref": "#/$defs/imageLock" },
        "s3": { "$ref": "#/$defs/imageLock" },
        "node": { "$ref": "#/$defs/imageLock" }
      },
      "propertyNames": { "pattern": "^[a-z0-9-]+$" },
      "additionalProperties": { "$ref": "#/$defs/imageLock" }
    }
  },
  "$defs": {
    "lockVersion": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.(0[1-9]|1[0-2])\\.[0-9]+$"
    },
    "semver": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "plugId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 64
    },
    "artefactUrl": {
      "description": "A URL reference (RFC 3986). CI writes a relative reference for each artefact of care-pi: <tag>/<asset>. The agent resolves it against dist_base of index.json. An absolute https URL is also valid.",
      "type": "string",
      "minLength": 1,
      "pattern": "^(https://[^\\s]+|[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*)$"
    },
    "imageLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest"],
      "properties": {
        "ref": {
          "description": "The image reference with its tag, for example docker.io/library/redis:8-alpine.",
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "description": "The manifest list digest.",
          "$ref": "#/$defs/digest"
        }
      }
    },
    "plugLock": {
      "description": "The resolved parts of one plug. A part is absent when the plug has no such part.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "backend": {
          "description": "The backend part.",
          "type": "object",
          "additionalProperties": false,
          "required": ["ref", "sha", "additional_plug"],
          "properties": {
            "ref": {
              "description": "The ref of solution.yaml.",
              "type": "string",
              "minLength": 1
            },
            "sha": {
              "description": "The resolved commit.",
              "$ref": "#/$defs/gitSha"
            },
            "additional_plug": {
              "description": "The ADDITIONAL_PLUGS entry with the default configs (upstream plugs/plug.py). The device merges the operator settings into configs.",
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "package_name", "version", "configs"],
              "properties": {
                "name": {
                  "description": "The Django app name.",
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                "package_name": {
                  "description": "The pip requirement without a version.",
                  "type": "string",
                  "pattern": "^git\\+https://[^\\s@]+$"
                },
                "version": {
                  "description": "@<sha>.",
                  "type": "string",
                  "pattern": "^@[0-9a-f]{40}$"
                },
                "configs": {
                  "description": "The default configs of the plug.",
                  "type": "object"
                }
              }
            }
          }
        },
        "frontend": {
          "description": "The frontend part. source built: CI built the bundle from repo at sha; the device serves it at /plugs/<slug>/<sha12>/. source external: the browser loads url; the bundle is not pinned.",
          "oneOf": [
            { "$ref": "#/$defs/frontendBuilt" },
            { "$ref": "#/$defs/frontendExternal" }
          ]
        }
      }
    },
    "frontendBuilt": {
      "description": "A frontend bundle that CI built from repo at sha (release plug-<slug>-<sha12>).",
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "source", "ref", "sha", "url", "sha256", "entry", "size_bytes"],
      "properties": {
        "slug": { "description": "The slug of the plug_config row.", "$ref": "#/$defs/slug" },
        "source": { "description": "built.", "const": "built" },
        "ref": { "description": "The ref of solution.yaml.", "type": "string", "minLength": 1 },
        "sha": { "description": "The resolved commit.", "$ref": "#/$defs/gitSha" },
        "url": { "description": "The bundle (tar.gz), relative to dist_base.", "$ref": "#/$defs/artefactUrl" },
        "sha256": { "description": "The SHA-256 of the bundle file.", "$ref": "#/$defs/sha256" },
        "entry": { "description": "The path of remoteEntry.js in the bundle.", "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9._/-]*\\.js$" },
        "size_bytes": { "description": "The size of the bundle file.", "type": "integer", "minimum": 1 }
      }
    },
    "frontendExternal": {
      "description": "A frontend bundle that the browser loads from url. Not pinned: sha, sha256, entry, and size_bytes are null.",
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "source", "ref", "sha", "url", "sha256", "entry", "size_bytes"],
      "properties": {
        "slug": { "description": "The slug of the plug_config row.", "$ref": "#/$defs/slug" },
        "source": { "description": "external.", "const": "external" },
        "ref": { "description": "null.", "type": "null" },
        "sha": { "description": "null.", "type": "null" },
        "url": { "description": "The absolute https URL of remoteEntry.js.", "type": "string", "pattern": "^https://[^\\s]+$" },
        "sha256": { "description": "null.", "type": "null" },
        "entry": { "description": "null.", "type": "null" },
        "size_bytes": { "description": "null.", "type": "null" }
      }
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    }
  },
  "examples": [
    {
      "apiVersion": "care-pi/v1",
      "kind": "SolutionLock",
      "name": "care-clinic",
      "version": "2026.11.0",
      "created_at": "2026-11-14T10:00:00Z",
      "created_by": "rithviknishad (workflow solution-lock, run 11650001)",
      "notes": "First lock of CARE Clinic. care develop of 2026-11-13, care_fe develop of 2026-11-13.\n",
      "min_agent_version": "v0.4.0",
      "source": {
        "commit": "9505cacb7c710ed17125fcc6cb3669e8ddca6c8c",
        "solution_sha256": "c9e9420c990680921a6caf90891119c1267797f3025c68d6cc58a4ac1a53f193",
        "run_url": "https://github.com/rithviknishad/care-pi/actions/runs/11650001"
      },
      "solution": {
