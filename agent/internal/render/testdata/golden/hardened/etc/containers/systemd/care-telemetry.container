# Generated by care-pi from /etc/care-pi/config.yaml. Do not edit.
# vmagent (telemetry, Phase 7, O12; docs/telemetry.md): it scrapes node_exporter each 60s and sends
# the samples to https://metrics.example.org/api/v1/write (Prometheus remote write). It keeps a small queue on disk when the
# receiver does not answer. It runs only with telemetry.enabled: then nothing else leaves the device.

[Unit]
Description=care-pi vmagent (opt-in telemetry: remote write)
PartOf=care.target
Wants=care-node-exporter.service
After=care-node-exporter.service

[Container]
ContainerName=care-telemetry
Image=care-telemetry.image
Network=host
ReadOnly=true
Volume=/etc/care-pi/rendered/telemetry:/etc/vmagent:ro
Volume=/var/lib/care-pi/telemetry/vmagent:/var/lib/vmagent
# The basic auth password (secrets/telemetry_password) as a file.
Secret=care-pi-telemetry-password,type=mount,mode=0400
Exec=-promscrape.config=/etc/vmagent/scrape.yml -remoteWrite.url=https://metrics.example.org/api/v1/write -remoteWrite.basicAuth.username=sunrise -remoteWrite.basicAuth.passwordFile=/run/secrets/care-pi-telemetry-password -remoteWrite.tmpDataPath=/var/lib/vmagent -remoteWrite.maxDiskUsagePerURL=64MB -httpListenAddr=127.0.0.1:8429 -memory.allowedBytes=48MB -loggerLevel=WARN

[Service]
ExecStartPre=/bin/mkdir -p /var/lib/care-pi/telemetry/vmagent
MemoryMax=96M
MemorySwapMax=0
Restart=always
RestartSec=10
TimeoutStartSec=300

[Install]
WantedBy=care.target
