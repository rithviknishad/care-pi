# Generated by care-pi from /etc/care-pi/config.yaml. Do not edit.
# versitygw serves the S3 API over /var/lib/care-pi/s3. Object metadata is in xattrs.
# VGW_REGION must equal BUCKET_REGION of Care.

[Unit]
Description=care-pi object storage (versitygw)
PartOf=care.target
Requires=care-clock.service
After=care-clock.service

[Container]
ContainerName=care-s3
Image=docker.io/versity/versitygw@sha256:8243b6c92bdad057ff20030315ab4110b08b0bb1a2c3d3b5caeb87f323531659
Pod=care.pod
RunInit=true
Volume=/var/lib/care-pi/s3:/data
Environment=VGW_REGION=ap-south-1
Secret=care-pi-s3-access-key,type=env,target=ROOT_ACCESS_KEY
Secret=care-pi-s3-secret-key,type=env,target=ROOT_SECRET_KEY
Exec=posix /data

[Service]
MemoryMax=256M
MemorySwapMax=0
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=care.target
