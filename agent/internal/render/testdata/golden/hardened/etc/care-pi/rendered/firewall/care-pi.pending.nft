#!/usr/sbin/nft -f
# Generated by care-pi from /etc/care-pi/config.yaml. Do not edit.
# The table inet care-pi (docs/console-server.md, section 13). care-pi-firewall.service loads this file
# (/etc/systemd/system/care-pi-firewall.service.d/50-care-pi.conf). It changes only this table: the tables of podman (netavark) and Tailscale stay.
# security.firewall.policy: drop. security.ssh.allow: false.
# The first two commands make "nft -f" idempotent: create the table when it is missing, then delete it.
table inet care-pi
delete table inet care-pi

table inet care-pi {
  chain input {
    type filter hook input priority filter; policy drop;
    iifname "lo" accept
    ct state established,related accept
    ct state invalid drop
    # ICMP and ICMPv6 (neighbour discovery, router advertisements, path MTU).
    ip protocol icmp accept
    meta l4proto ipv6-icmp accept
    # The DHCP client: DHCPv4 offers (broadcast) and DHCPv6 replies.
    udp sport 67 udp dport 68 accept
    ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept
    # Care and the console (S48). The pod publishes them with DNAT (netavark), so these packets pass the forward
    # hook; the rule is for a listener on the host.
    tcp dport { 80, 443, 8443 } accept
    # mDNS (avahi).
    udp dport 5353 accept
    # WireGuard of tailscaled (Tailscale mode).
    udp dport 41641 accept
    # DNS of aardvark-dns for the containers on a podman network.
    iifname "podman*" meta l4proto { tcp, udp } th dport 53 accept
    # security.firewall.allow_ports (S64): the other services of the host, also on tailscale0.
    iifname "eth0" tcp dport 9100 accept comment "node exporter avocado"
    iifname "tailscale0" tcp dport 9256 accept comment "process exporter"
    udp dport 51820 accept
    iifname "wlan0" tcp dport 22 accept
  }
}
