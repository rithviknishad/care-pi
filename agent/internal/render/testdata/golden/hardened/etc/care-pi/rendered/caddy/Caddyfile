# Generated by care-pi from /etc/care-pi/config.yaml. Do not edit.
{
	# The admin API listens on a unix socket in this container only.
	# Other containers of the pod share localhost, so a TCP admin port is not safe.
	# "care-pi apply" reloads Caddy through this socket with "caddy reload".
	admin unix//run/caddy-admin.sock
	auto_https disable_redirects
	# Clients that connect by IP send no SNI. Without this, the TLS handshake fails.
	default_sni 192.168.1.10
	servers {
		# Port 443/udp is not published, so HTTP/3 is off.
		protocols h1 h2
	}
	# The Coraza WAF (security.waf, Phase 7) runs before the proxy in the @api routes.
	order coraza_waf first
	# The local CA uses the name-constrained root of the agent (07 section 4.1, docs/connectivity.md).
	# Caddy makes its intermediate and the leaf certificates below this root. The root permits
	# only the names and the address ranges of its name constraints.
	pki {
		ca local {
			name care-pi
			root {
				cert /etc/care-pi-ca/root.crt
				key /etc/care-pi-ca/root.key
			}
		}
	}
}

# The routes of Care on port 443. Each site of port 443 imports them.
(care) {
	encode zstd gzip
	header -Server
	log {
		output stdout
		format console
	}

	# Django: API, static files (whitenoise), media, and health.
	# /admin/* is not routed (O16). Django sends HSTS; local CA hosts must not get it.
	@api path /api/* /staticfiles/* /mediafiles/* /ping/ /health/* /app_version/
	handle @api {
		# The Coraza WAF with the OWASP CRS v4 of the module (security.waf; docs/console-server.md section 15).
		# Mode block, paranoia level 2. The audit log goes to the journal of care-caddy.
		# Parts A, H, Z only: part B (the request headers) has the bearer token of Care and the console cookie.
		coraza_waf {
			load_owasp_crs
			directives `
				Include @coraza.conf-recommended
				Include @crs-setup.conf.example
				SecRuleEngine On
				SecRequestBodyAccess On
				SecResponseBodyAccess Off
				SecAuditEngine RelevantOnly
				SecAuditLogType Serial
				SecAuditLog /dev/stdout
				SecAuditLogFormat JSON
				SecAuditLogParts AHZ
				SecAction "id:900000,phase:1,pass,t:none,nolog,setvar:tx.blocking_paranoia_level=2"
				Include @owasp_crs/*.conf
			`
		}
		reverse_proxy localhost:9000 {
			header_up X-Forwarded-Proto https
			# The browser also sends the console cookie to this port (docs/api/README.md, section 2.5).
			# Remove it, so Care and its plugs never get it. The second line removes a "; " at the start.
			header_up Cookie "(^|;\s*)__Host-care_pi_session=[^;]*" ""
			header_up Cookie "^;\s*" ""
			header_down -Strict-Transport-Security
		}
	}

	# Object storage (versitygw). Presigned URLs sign the path and the Host header,
	# so Caddy does not change the path and does not change the Host header.
	@s3 path /patient-bucket/* /facility-bucket/*
	handle @s3 {
		request_body {
			max_size 200MB
		}
		reverse_proxy localhost:7070 {
			flush_interval -1
			# Remove the console cookie, as for @api.
			header_up Cookie "(^|;\s*)__Host-care_pi_session=[^;]*" ""
			header_up Cookie "^;\s*" ""
		}
	}

	# FE plug bundles: /plugs/<slug>/<sha>/...
	handle /plugs/* {
		root * /srv
		header Access-Control-Allow-Origin "*"
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# The public operations of the agent (docs/api/README.md, section 1): status, health, and the root CA.
	# The agent listens on a unix socket. It sends its own Cache-Control headers.
	# Below /_care-pi/ the agent answers only the public operations. Each other path gives 404.
	@agent path /_care-pi/*
	handle @agent {
		reverse_proxy unix//run/care-pi/api.sock
	}

	# The console has its own origin on port 8443 (S48).
	@console path /console /console/*
	handle @console {
		redir https://{host}:8443/ 308
	}

	# Everything else: a status page, or the care_fe build.
	# The agent switches the status pages with flag files in /var/lib/care-pi/state/mode.
	# Caddy checks the flag files and fe/current on each request, so no reload is necessary.
	handle {
		header {
			X-Frame-Options SAMEORIGIN
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			Permissions-Policy "geolocation=(self), microphone=(self)"
		}

		@clock file {
			root /srv/mode
			try_files /clock-wait
		}
		handle @clock {
			root * /etc/caddy/status
			rewrite * /clock.html
			header Cache-Control "no-store"
			header Retry-After 30
			file_server {
				status 503
			}
		}

		@maintenance file {
			root /srv/mode
			try_files /maintenance
		}
		handle @maintenance {
			root * /etc/caddy/status
			rewrite * /maintenance.html
			header Cache-Control "no-store"
			header Retry-After 30
			file_server {
				status 503
			}
		}

		@fe file {
			root /srv/fe/current
			try_files /index.html
		}
		handle @fe {
			root * /srv/fe/current
			@assets path /assets/*
			header @assets Cache-Control "public, max-age=31536000, immutable"
			try_files {path} /index.html
			file_server
		}

		# No FE build is current: fe.provider is none, or no build exists yet.
		handle {
			root * /etc/caddy/status
			rewrite * /setup.html
			header Cache-Control "no-store"
			header Retry-After 60
			file_server {
				status 503
			}
		}
	}

	# The agent does not answer (care-pi.service stopped): a problem document, not an empty 502.
	# Other errors (for example of care-api) keep the default response.
	handle_errors 502 503 504 {
		@agent_down path /_care-pi/*
		handle @agent_down {
			header Content-Type application/problem+json
			header Cache-Control no-store
			header Retry-After 5
			respond `{"type":"https://care-pi.rithviknishad.dev/problems/unavailable","title":"The agent is not ready","status":503,"detail":"care-pi.service does not answer. Run: sudo systemctl status care-pi.service","instance":"/_care-pi/","retry_after_s":5}` 503
		}
	}
}

# The console origin (S48): the console SPA at /, the API at /api/v1/, and the public operations
# at /_care-pi/. Each request goes to the agent. Each site of port 8443 imports these routes.
(console) {
	header -Server
	header {
		X-Frame-Options SAMEORIGIN
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(self), microphone=(self)"
	}
	log {
		output stdout
		format console
	}
	# Compress only the static files of the SPA. The event streams must not wait in a buffer.
	@assets path /assets/*
	encode @assets zstd gzip
	# The largest body of the API is 1 MiB. The agent has smaller limits for most operations.
	request_body {
		max_size 1MiB
	}
	reverse_proxy unix//run/care-pi/api.sock {
		flush_interval -1
	}
	# A body larger than max_size: a problem document, as from the agent.
	handle_errors 413 {
		header Content-Type application/problem+json
		header Cache-Control no-store
		respond `{"type":"https://care-pi.rithviknishad.dev/problems/payload-too-large","title":"The request body is too large","status":413,"detail":"The body is larger than 1 MiB.","instance":"/"}` 413
	}
	handle_errors 502 503 504 {
		header Content-Type application/problem+json
		header Cache-Control no-store
		header Retry-After 5
		respond `{"type":"https://care-pi.rithviknishad.dev/problems/unavailable","title":"The agent is not ready","status":503,"detail":"care-pi.service does not answer. Run: sudo systemctl status care-pi.service","instance":"/","retry_after_s":5}` 503
	}
}

# Port 80 serves only redirects (P9).
http://care.local, http://192.168.1.10, http://10.0.0.5, http://care.clinic.example.org {
	redir https://{host}{uri} 308
}

# The local CA mode: care.local and the LAN addresses. No HSTS (07 F7).
https://care.local, https://192.168.1.10, https://10.0.0.5 {
	tls internal
	import care
}

# The Tailscale name (P11): the certificate comes from tailscaled through its socket.
https://care.clinic.example.org {
	tls {
		get_certificate tailscale
	}
	header Strict-Transport-Security "max-age=31536000"
	import care
}

# The console on port 8443: the same certificates as port 443.
https://care.local:8443, https://192.168.1.10:8443, https://10.0.0.5:8443 {
	tls internal
	import console
}

https://care.clinic.example.org:8443 {
	tls {
		get_certificate tailscale
	}
	header Strict-Transport-Security "max-age=31536000"
	import console
}
