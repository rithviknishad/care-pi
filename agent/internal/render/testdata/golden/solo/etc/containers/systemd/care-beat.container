# Generated by care-pi from /etc/care-pi/config.yaml. Do not edit.
# Celery beat. Upstream celery_beat.sh runs migrate, sync_permissions_roles, and sync_valueset
# before it reports healthy, so care-api and care-worker start after it.

[Unit]
Description=care-pi Celery beat (runs the database migrations)
PartOf=care.target
Requires=care-clock.service care-db.service care-redis.service
After=care-clock.service care-db.service care-redis.service

[Container]
ContainerName=care-beat
Image=ghcr.io/ohcnetwork/care@sha256:35c3ce3ffe01b9b27d1790ebf0cf5df72b80d4c058bf3926130952678f2d132f
Pod=care.pod
RunInit=true
Exec=bash /app/celery_beat.sh
EnvironmentFile=/etc/care-pi/rendered/care/backend.env
Secret=care-pi-django-secret-key,type=env,target=DJANGO_SECRET_KEY
Secret=care-pi-jwks-base64,type=env,target=JWKS_BASE64
Secret=care-pi-postgres-password,type=env,target=POSTGRES_PASSWORD
Secret=care-pi-database-url,type=env,target=DATABASE_URL
Secret=care-pi-s3-access-key,type=env,target=BUCKET_KEY
Secret=care-pi-s3-secret-key,type=env,target=BUCKET_SECRET
HealthCmd=/app/healthcheck.sh
HealthInterval=10s
HealthTimeout=10s
HealthStartPeriod=900s
HealthRetries=6
Notify=healthy

[Service]
MemoryMax=512M
MemorySwapMax=128M
Restart=always
RestartSec=10
# celery beat exits with 143 (128 + SIGTERM) when podman stops the container. This is a clean stop.
SuccessExitStatus=143
TimeoutStartSec=1200

[Install]
WantedBy=care.target
