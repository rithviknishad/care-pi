# Generated by care-pi from /etc/care-pi/config.yaml. Do not edit.
# An incremental pgBackRest backup to the local repository. The CLI writes a job with the source timer.

[Unit]
Description=care-pi incremental backup of the database
Documentation=https://github.com/rithviknishad/care-pi/blob/main/docs/backups.md

[Service]
Type=oneshot
ExecStart=/usr/local/bin/care-pi backup run --scope local-db --type incr --from-timer
# Its own memory cap, not the cap of care-pi.service. Low CPU and IO priority (02 section 4).
MemoryMax=512M
MemorySwapMax=128M
Nice=10
IOSchedulingClass=idle
Environment=GOMAXPROCS=2
TimeoutStartSec=6h
