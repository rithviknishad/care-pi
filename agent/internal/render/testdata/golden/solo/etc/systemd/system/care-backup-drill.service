# Generated by care-pi from /etc/care-pi/config.yaml. Do not edit.
# A restore of the newest local backup into a temporary container (archive_mode=off), then a check, then a delete.

[Unit]
Description=care-pi restore drill
Documentation=https://github.com/rithviknishad/care-pi/blob/main/docs/backups.md

[Service]
Type=oneshot
ExecStart=/usr/local/bin/care-pi backup drill --from-timer
# Its own memory cap, not the cap of care-pi.service. Low CPU and IO priority (02 section 4).
MemoryMax=512M
MemorySwapMax=128M
Nice=10
IOSchedulingClass=idle
Environment=GOMAXPROCS=2
TimeoutStartSec=2h
