# Generated by care-pi from /etc/care-pi/config.yaml. Do not edit.

[Unit]
Description=care-pi Redis (cache and Celery broker)
PartOf=care.target
Requires=care-clock.service
After=care-clock.service

[Container]
ContainerName=care-redis
Image=docker.io/library/redis@sha256:1111111111111111111111111111111111111111111111111111111111111111
Pod=care.pod
RunInit=true
Volume=/var/lib/care-pi/redis:/data
Exec=redis-server --save 60 1000
HealthCmd=redis-cli ping
HealthInterval=5s
HealthTimeout=5s
HealthStartPeriod=10s
HealthRetries=10
Notify=healthy

[Service]
MemoryMax=96M
MemorySwapMax=0
OOMScoreAdjust=-500
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=care.target
