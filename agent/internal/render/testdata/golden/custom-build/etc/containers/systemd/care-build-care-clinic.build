# Generated by care-pi from /etc/care-pi/config.yaml. Do not edit.
# The local image build of care (track custom, docs/solutions.md section 13.1): the upstream image
# at its digest and the backend plugs of install-plugs.json. Only the agent starts it, in staging.
# Before the start, the agent sets care-api to 1 gunicorn worker and stops care-worker.

[Unit]
Description=care-pi image build 5c0ffee15c0ffee1

[Build]
ImageTag=localhost/care-pi/care:5c0ffee15c0ffee1
File=/etc/care-pi/rendered/build/care/Containerfile
SetWorkingDirectory=/etc/care-pi/rendered/build/care
PodmanArgs=--build-arg=BASE=ghcr.io/ohcnetwork/care@sha256:abababababababababababababababababababababababababababababababab
Pull=never

[Service]
MemoryHigh=640M
MemoryMax=768M
OOMScoreAdjust=900
TimeoutStartSec=3600
