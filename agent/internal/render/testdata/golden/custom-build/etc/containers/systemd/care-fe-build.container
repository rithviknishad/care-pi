# Generated by care-pi from /etc/care-pi/config.yaml. Do not edit.
# The care_fe builder (fe.provider: local). Only the agent starts it ("care-pi apply", "care-pi fe build").
# Before the start, the agent sets care-api to 1 gunicorn worker and stops care-worker (S8).
# The unit is shaped, not capped (SP4): the build needs about 2 GiB and zram swap of 1x RAM or more.
# Each start fetches the source only when the sha changed. node_modules and the npm cache stay in /build.

[Unit]
Description=care-pi FE build 015ecdd390b636a7
PartOf=care.target

[Container]
ContainerName=care-fe-build
Image=docker.io/library/node@sha256:edc47295e205f2297f96fcd0a6d7facd07f30aa35bac4928e52f647e81b81019
RunInit=true
# The container needs the internet: codeload.github.com and the npm registry.
Volume=/var/lib/care-pi/build/care_fe:/build
Volume=/etc/care-pi/rendered/fe:/build/env:ro
Volume=/var/lib/care-pi/fe:/out
Environment=CARE_FE_REPO=ohcnetwork/care_fe CARE_FE_SHA=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb BUILD_ID=015ecdd390b636a7
LogDriver=passthrough
Exec=bash /build/env/fe-build.sh

[Service]
Type=oneshot
MemoryHigh=768M
MemoryMax=1700M
MemorySwapMax=1500M
OOMScoreAdjust=900
Restart=no
TimeoutStartSec=1800
