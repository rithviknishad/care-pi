# Generated by care-pi from /etc/care-pi/config.yaml. Do not edit.
# The FE plug builder (experimental; track custom, docs/solutions.md section 13.2).
# Only the agent starts it. The agent writes the plug, the sha, and the paths to
# /var/lib/care-pi/build/plugs/current.env before each start, and scales Care down as for an FE build.

[Unit]
Description=care-pi FE plug build
PartOf=care.target

[Container]
ContainerName=care-plug-build
Image=docker.io/library/node@sha256:edc47295e205f2297f96fcd0a6d7facd07f30aa35bac4928e52f647e81b81019
RunInit=true
# The container needs the internet: codeload.github.com and the npm registry.
Volume=/var/lib/care-pi/build/plugs:/build
Volume=/etc/care-pi/rendered/plugs:/build/env:ro
Volume=/var/lib/care-pi/plugs:/out
EnvironmentFile=/var/lib/care-pi/build/plugs/current.env
LogDriver=passthrough
Exec=bash /build/env/plug-build.sh

[Service]
Type=oneshot
MemoryHigh=768M
MemoryMax=1700M
MemorySwapMax=1500M
OOMScoreAdjust=900
Restart=no
TimeoutStartSec=1800
