# Generated by care-pi from /etc/care-pi/config.yaml. Do not edit.
# PostgreSQL 17 with pgBackRest. WAL goes to the local encrypted repository only (S40).

[Unit]
Description=care-pi database (PostgreSQL 17 with pgBackRest)
PartOf=care.target
Requires=care-clock.service
After=care-clock.service

[Container]
ContainerName=care-db
Image=ghcr.io/rithviknishad/care-pi/postgres-pgbackrest@sha256:27eb6b9734637cd942e64f0d527c2b26734f31231269f004e2be4f864f023e69
Pod=care.pod
RunInit=true
Volume=/var/lib/care-pi/pg:/var/lib/postgresql/data
Volume=/var/lib/care-pi/backup/pg:/var/lib/pgbackrest
Volume=/etc/care-pi/rendered/db:/etc/pgbackrest:ro
Environment=POSTGRES_DB=care
Environment=POSTGRES_USER=postgres
Secret=care-pi-postgres-password,type=env,target=POSTGRES_PASSWORD
Secret=care-pi-pgbackrest-cipher-pass,type=env,target=PGBACKREST_REPO1_CIPHER_PASS
Exec=postgres -c shared_buffers=128MB -c max_connections=40 -c work_mem=4MB -c archive_mode=on -c archive_timeout=300s -c "archive_command=pgbackrest --stanza=main archive-push %%p"
HealthCmd=pg_isready -U postgres -d care
HealthInterval=5s
HealthTimeout=5s
HealthStartPeriod=60s
HealthRetries=20
Notify=healthy
# podman stops the container with this timeout, then sends SIGKILL. The default is 10 s.
# PostgreSQL needs more time for a clean shutdown. TimeoutStopSec in [Service] is longer.
StopTimeout=110

[Service]
MemoryMax=384M
MemorySwapMax=0
OOMScoreAdjust=-500
Restart=always
RestartSec=5
TimeoutStartSec=900
TimeoutStopSec=120

[Install]
WantedBy=care.target
