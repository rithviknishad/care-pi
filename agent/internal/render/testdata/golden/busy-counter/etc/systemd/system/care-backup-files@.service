# Generated by care-pi from /etc/care-pi/config.yaml. Do not edit.
# A restic snapshot of the files (/var/lib/care-pi/s3, with xattrs) and /etc/care-pi to one destination.

[Unit]
Description=care-pi files snapshot to the destination %i
Documentation=https://github.com/rithviknishad/care-pi/blob/main/docs/backups.md

[Service]
Type=oneshot
ExecStart=/usr/local/bin/care-pi backup run --scope destination --destination %i --snapshot files --from-timer
# Its own memory cap, not the cap of care-pi.service. Low CPU and IO priority (02 section 4).
MemoryMax=512M
MemorySwapMax=128M
Nice=10
IOSchedulingClass=idle
Environment=GOMAXPROCS=2
TimeoutStartSec=12h
