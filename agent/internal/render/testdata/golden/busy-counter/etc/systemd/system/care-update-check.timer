# Generated by care-pi from /etc/care-pi/config.yaml. Do not edit.
# The daily update check (docs/solutions.md, section 10.2): at a random time in the afternoon,
# when a clinic usually has internet.

[Unit]
Description=care-pi update check

[Timer]
OnCalendar=*-*-* 12:00:00
RandomizedDelaySec=4h
Persistent=true

[Install]
WantedBy=timers.target
