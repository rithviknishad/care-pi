# Generated by care-pi from /etc/care-pi/config.yaml. Do not edit.
# Environment of care-api, care-worker, and care-beat.
# Podman secrets add DJANGO_SECRET_KEY, JWKS_BASE64, POSTGRES_PASSWORD, DATABASE_URL, BUCKET_KEY, and BUCKET_SECRET.
# The units add GUNICORN_WORKERS and CELERY_WORKER_CONCURRENCY.

# Set by care-pi. env.backend cannot change these.
ADDITIONAL_PLUGS=[]
BUCKET_ENDPOINT=http://localhost:7070
BUCKET_EXTERNAL_ENDPOINT=https://care.local
BUCKET_PROVIDER=MINIO
CELERY_BROKER_URL=redis://localhost:6379/0
CSRF_TRUSTED_ORIGINS=["https://care.local","https://192.168.1.10","https://10.0.0.5"]
DJANGO_ALLOWED_HOSTS=["care.local","192.168.1.10","10.0.0.5","localhost","127.0.0.1"]
POSTGRES_DB=care
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
REDIS_URL=redis://localhost:6379/0

# Defaults of care-pi, then the solution, then the plugs, then env.backend in config.yaml.
BUCKET_REGION=ap-south-1
CURRENT_DOMAIN=https://care.local
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SETTINGS_MODULE=config.settings.production
FACILITY_S3_BUCKET=facility-bucket
FILE_UPLOAD_BUCKET=patient-bucket
RATE_LIMIT=5/10m
USE_SMS=False
