# Generated by care-pi from /etc/care-pi/config.yaml. Do not edit.
# pgbackrest verify of the local repository; restic forget, prune, and check of each destination.

[Unit]
Description=care-pi verify of the backups
Documentation=https://github.com/rithviknishad/care-pi/blob/main/docs/backups.md

[Service]
Type=oneshot
ExecStart=/usr/local/bin/care-pi backup verify --scope all --prune --from-timer
# Its own memory cap, not the cap of care-pi.service. Low CPU and IO priority (02 section 4).
MemoryMax=512M
MemorySwapMax=128M
Nice=10
IOSchedulingClass=idle
Environment=GOMAXPROCS=2
TimeoutStartSec=12h
