# Generated by care-pi from /etc/care-pi/config.yaml. Do not edit.
# A restic snapshot of the local repository and /etc/care-pi to one destination. A timer run writes no job (docs/backups.md).

[Unit]
Description=care-pi db snapshot to the destination %i
Documentation=https://github.com/rithviknishad/care-pi/blob/main/docs/backups.md

[Service]
Type=oneshot
ExecStart=/usr/local/bin/care-pi backup run --scope destination --destination %i --snapshot db --from-timer
# Its own memory cap, not the cap of care-pi.service. Low CPU and IO priority (02 section 4).
MemoryMax=512M
MemorySwapMax=128M
Nice=10
IOSchedulingClass=idle
Environment=GOMAXPROCS=2
TimeoutStartSec=6h
