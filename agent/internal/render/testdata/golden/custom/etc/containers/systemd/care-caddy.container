# Generated by care-pi from /etc/care-pi/config.yaml. Do not edit.
# Caddy: TLS, routing, the FE build, plug bundles, and status pages.
# It does not wait for the clock gate, so it can show the clock status page.

[Unit]
Description=care-pi Caddy (TLS and routing)
PartOf=care.target

[Container]
ContainerName=care-caddy
Image=ghcr.io/rithviknishad/care-pi/caddy@sha256:2cf85b0dc0050d1e8efe04fed902479aca73b8d2ea46471c82e895990feb3f2e
Pod=care.pod
RunInit=true
Exec=caddy run --config /etc/caddy/Caddyfile --adapter caddyfile
Volume=/etc/care-pi/rendered/caddy:/etc/caddy:ro
Volume=/var/lib/care-pi/caddy:/data
Volume=/var/lib/care-pi/fe:/srv/fe:ro
Volume=/var/lib/care-pi/plugs:/srv/plugs:ro
Volume=/var/lib/care-pi/state/mode:/srv/mode:ro

[Service]
MemoryMax=96M
MemorySwapMax=0
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=care.target
