# Generated by care-pi from /etc/care-pi/config.yaml. Do not edit.
# Send the LAN address of sunrise-4f2a.care-pi.rithviknishad.dev to the DNS service when it changed (idempotent).

[Unit]
Description=care-pi DNS address update (sunrise-4f2a.care-pi.rithviknishad.dev)
After=network-online.target care-pi.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/care-pi tls public update-address --scheduled
TimeoutStartSec=120
