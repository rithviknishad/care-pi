# Generated by care-pi from /etc/care-pi/config.yaml. Do not edit.
# The public mode (docs/connectivity.md): send the LAN address of sunrise-4f2a.care-pi.rithviknishad.dev to the DNS service.
# The service records the address that the agent sends (a LAN address), not the public address of the clinic.
# "care-pi apply" of an address change (the NetworkManager hook) also sends it.

[Unit]
Description=care-pi DNS address update (sunrise-4f2a.care-pi.rithviknishad.dev)

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
RandomizedDelaySec=30s

[Install]
WantedBy=timers.target
