# Generated by care-pi from /etc/care-pi/config.yaml. Do not edit.
# The SFTP destinations. restic runs "ssh -F <this file> -i <key> care-dest-<id>". The private key
# comes from the recovery key; the agent writes it to /run/care-pi-backup/ for each run.

Host care-dest-nas
  HostName nas.lan
  Port 2222
  User care
  HostKeyAlias care-dest-nas
  HostKeyAlgorithms ecdsa-sha2-nistp256
  UserKnownHostsFile /etc/care-pi/rendered/backup/known_hosts
  GlobalKnownHostsFile /dev/null
  StrictHostKeyChecking yes
  UpdateHostKeys no
  IdentitiesOnly yes
  PasswordAuthentication no
  KbdInteractiveAuthentication no
  BatchMode yes
  ConnectTimeout 20
  ServerAliveInterval 15
  ServerAliveCountMax 4
