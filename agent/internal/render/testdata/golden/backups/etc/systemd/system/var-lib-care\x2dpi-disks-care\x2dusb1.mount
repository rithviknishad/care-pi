# Generated by care-pi from /etc/care-pi/config.yaml. Do not edit.
# The backup disk care-usb1 (docs/backups.md, "USB disk"). The automount unit mounts it at the
# first use. A disk that is not connected does not stop the boot (nofail).

[Unit]
Description=care-pi backup disk care-usb1
Documentation=https://github.com/rithviknishad/care-pi/blob/main/docs/backups.md

[Mount]
What=/dev/disk/by-label/care-usb1
Where=/var/lib/care-pi/disks/care-usb1
Type=ext4
Options=nofail,noatime,x-systemd.device-timeout=10s
TimeoutSec=30
