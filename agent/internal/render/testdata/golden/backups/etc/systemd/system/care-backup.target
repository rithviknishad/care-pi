# Generated by care-pi from /etc/care-pi/config.yaml. Do not edit.
# The backup timers of care-pi (docs/backups.md). The agent enables this target. A stop of the target
# stops each timer (PartOf=); the restore jobs and backups.paused use it. The automount units of the
# backup disks are here too, so the disks mount at their first use.

[Unit]
Description=care-pi backup timers
Documentation=https://github.com/rithviknishad/care-pi/blob/main/docs/backups.md
Wants=care-backup-db-full.timer care-backup-db-incr.timer care-backup-verify.timer care-backup-drill.timer care-backup-db@usb.timer care-backup-files@usb.timer care-backup-db@nas.timer care-backup-files@nas.timer care-backup-db@b2.timer care-backup-files@b2.timer var-lib-care\x2dpi-disks-care\x2dusb1.automount

[Install]
WantedBy=multi-user.target
