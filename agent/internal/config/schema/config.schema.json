{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rithviknishad/care-pi/agent/internal/config/schema/config.schema.json",
  "title": "care-pi config.yaml",
  "description": "Desired state of one care-pi host. docs/config.md describes each key.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": {
      "description": "Schema version of this file.",
      "const": 1
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "description": "Name of the clinic. The status pages show it.",
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[^\\r\\n<>]*$"
        },
        "hostname": {
          "description": "mDNS label. The host name is <hostname>.local.",
          "$ref": "#/$defs/dnsLabel"
        }
      }
    },
    "solution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Name of a solution in solutions/<name>/solution.yaml.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "track": {
          "enum": ["stable", "pinned", "custom"]
        },
        "pin": {
          "description": "Solution version for track pinned, for example 2026.11.0.",
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}\\.[0-9]{1,2}\\.[0-9]+$"
        },
        "custom": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "care_ref": {
              "description": "Image tag or digest of the care image (track custom).",
              "type": ["string", "null"],
              "$ref": "#/$defs/ref"
            },
            "care_fe_ref": {
              "description": "Branch, tag, or full commit sha of care_fe (track custom).",
              "type": ["string", "null"],
              "$ref": "#/$defs/ref"
            },
            "plugs": {
              "type": "array",
              "items": { "$ref": "#/$defs/plugCustom" }
            }
          }
        },
        "plugs": {
          "description": "Phase 4. The operator choices for the plugs of the solution, by plug id: on or off, and the values of the settings form. Each track accepts these choices. They do not make the track custom. Secret values are not in this file: the agent keeps them in /etc/care-pi/secrets/plug-<id>.json.",
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$" },
          "additionalProperties": { "$ref": "#/$defs/plugChoice" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "track": { "const": "pinned" } }, "required": ["track"] },
          "then": { "required": ["pin"], "properties": { "pin": { "type": "string" } } }
        }
      ]
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": {
          "enum": ["solo", "small-clinic", "busy-counter", "custom"]
        },
        "custom": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gunicorn_workers": { "type": "integer", "minimum": 1, "maximum": 8 },
            "celery_concurrency": { "type": "integer", "minimum": 1, "maximum": 4 },
            "pg_shared_buffers_mb": { "type": "integer", "minimum": 32, "maximum": 2048 }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "preset": { "const": "custom" } }, "required": ["preset"] },
          "then": {
            "required": ["custom"],
            "properties": {
              "custom": { "required": ["gunicorn_workers", "celery_concurrency", "pg_shared_buffers_mb"] }
            }
          }
        }
      ]
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "local_ca": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "public": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "clinic_id": {
              "type": ["string", "null"],
              "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
            },
            "acme_ca": { "type": ["string", "null"], "pattern": "^https://[^\\s]+$" }
          },
          "allOf": [
            {
              "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
              "then": { "required": ["clinic_id"], "properties": { "clinic_id": { "type": "string" } } }
            }
          ]
        },
        "tailscale": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "hostname": {
              "description": "The MagicDNS name. <host>.<tailnet>.ts.net with Tailscale; with control_url (Headscale), a name below the base domain of that server.",
              "type": ["string", "null"],
              "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z][a-z0-9-]{0,61}[a-z0-9]$"
            },
            "control_url": {
              "description": "Phase 7 (O4). The URL of a self-hosted control server (Headscale), for tailscale up --login-server. null: the Tailscale service.",
              "type": ["string", "null"],
              "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[^\\s]*)?$"
            }
          },
          "allOf": [
            {
              "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
              "then": { "required": ["hostname"], "properties": { "hostname": { "type": "string" } } }
            }
          ]
        }
      }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy": { "enum": ["ntp", "rtc"] }
      }
    },
    "backups": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wal_archive_timeout_min": {
          "description": "Postgres archive_timeout in minutes. This is the RPO when the database is idle.",
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "schedule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "db_full": { "$ref": "#/$defs/calendar" },
            "db_incr": { "$ref": "#/$defs/calendar" },
            "files": { "$ref": "#/$defs/calendar" },
            "verify": { "$ref": "#/$defs/calendar" },
            "drill": { "$ref": "#/$defs/calendar" }
          }
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "db_full": { "type": "integer", "minimum": 1, "maximum": 52 },
            "archive_days": { "type": "integer", "minimum": 1, "maximum": 3650 },
            "files_keep_daily": { "type": "integer", "minimum": 0, "maximum": 3650 },
            "files_keep_weekly": { "type": "integer", "minimum": 0, "maximum": 520 }
          }
        },
        "destinations": {
          "type": "array",
          "items": { "$ref": "#/$defs/destination" }
        },
        "paused": {
          "description": "Stop the backup timers. A manual backup is still possible.",
          "type": "boolean"
        },
        "alert_after_hours": {
          "description": "A destination without a successful snapshot for this time gets the banner destination-unreachable.",
          "type": "integer",
          "minimum": 1,
          "maximum": 720
        },
        "drill_enabled": {
          "description": "Run the restore drill at schedule.drill.",
          "type": "boolean"
        }
      }
    },
    "updates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auto": { "type": "boolean" },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "days": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"] }
            },
            "start": { "$ref": "#/$defs/clockTime" },
            "end": { "$ref": "#/$defs/clockTime" }
          }
        },
        "os_security": { "type": "boolean" },
        "os_reboot": {
          "description": "Phase 4. Reboot inside the update window when /run/reboot-required exists and no job runs.",
          "type": "boolean"
        },
        "os_full": {
          "description": "Phase 4. Run care-pi update --os (apt full-upgrade with the tested versions of the held packages) inside the update window, after the Care update.",
          "type": "boolean"
        },
        "index_url": {
          "description": "Phase 4. The URL of index.json (https:// or file://). null: the default URL of this agent release.",
          "type": ["string", "null"],
          "pattern": "^(https://|file:///)[^\\s]+$"
        },
        "require_signed": {
          "description": "Phase 7. Accept index.json and a solution lock only with a valid minisign signature (<file>.minisig) of a trusted key: the keys of the agent (solutions/keys) and /etc/care-pi/keys/*.pub. Default false.",
          "type": "boolean"
        }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend": {
          "description": "Non-secret environment variables for care-api, care-worker, and care-beat.",
          "type": ["object", "null"],
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "not": {
              "enum": [
                "ADDITIONAL_PLUGS",
                "BUCKET_ENDPOINT",
                "BUCKET_EXTERNAL_ENDPOINT",
                "BUCKET_KEY",
                "BUCKET_PROVIDER",
                "BUCKET_SECRET",
                "CELERY_BROKER_URL",
                "CELERY_WORKER_CONCURRENCY",
                "CSRF_TRUSTED_ORIGINS",
                "DATABASE_URL",
                "DJANGO_ALLOWED_HOSTS",
                "DJANGO_SECRET_KEY",
                "GUNICORN_WORKERS",
                "JWKS_BASE64",
                "POSTGRES_DB",
                "POSTGRES_HOST",
                "POSTGRES_PASSWORD",
                "POSTGRES_PORT",
                "POSTGRES_USER",
                "REDIS_URL"
              ]
            }
          },
          "additionalProperties": { "$ref": "#/$defs/envValue" }
        },
        "frontend": {
          "description": "Build-time environment variables for care_fe. A change needs a new FE build.",
          "type": ["object", "null"],
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "not": { "enum": ["REACT_CARE_API_URL"] }
          },
          "additionalProperties": { "$ref": "#/$defs/envValue" }
        }
      }
    },
    "fe": {
      "description": "The source of the care_fe build. See docs/fe.md.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": { "enum": ["none", "artifact", "local"], "default": "local" },
        "artifact_url": {
          "description": "The bundle (tar.gz) of the artifact provider. Absent or null: the default bundle of the solution for the care_fe sha.",
          "type": ["string", "null"],
          "pattern": "^(https|file)://[^\\s]+$"
        },
        "artifact_sha256": {
          "description": "The expected SHA-256 of the bundle, in hex.",
          "type": ["string", "null"],
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    },
    "images": {
      "description": "Overrides of the default images. Each value is a full image reference.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "care": { "$ref": "#/$defs/image" },
        "postgres": { "$ref": "#/$defs/image" },
        "caddy": { "$ref": "#/$defs/image" },
        "redis": { "$ref": "#/$defs/image" },
        "s3": { "$ref": "#/$defs/image" },
        "node": { "$ref": "#/$defs/image" }
      }
    },
    "uploads": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_body_mb": { "type": "integer", "minimum": 1, "maximum": 10240 }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wifi": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["ssid"],
              "properties": {
                "ssid": { "type": "string", "minLength": 1, "maxLength": 32 },
                "failover": { "type": "boolean" },
                "country": { "type": ["string", "null"], "pattern": "^[A-Z]{2}$" }
              }
            }
          ]
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "description": "Phase 7 (O12). Opt-in metrics with remote_write only (docs/telemetry.md). Nothing leaves the device while enabled is false.",
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
          "then": { "required": ["remote_write_url"], "properties": { "remote_write_url": { "type": "string" } } }
        }
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "remote_write_url": {
          "description": "The Prometheus remote-write URL of the receiver (VictoriaMetrics, Prometheus, Grafana Cloud, Mimir). Required when enabled is true.",
          "type": ["string", "null"],
          "pattern": "^https?://[^\\s]+$"
        },
        "username": {
          "description": "Phase 7. The basic auth user of the remote write. The password is /etc/care-pi/secrets/telemetry_password (care-pi telemetry set-password).",
          "type": ["string", "null"],
          "pattern": "^[^\\s:]{1,128}$"
        },
        "interval_s": {
          "description": "Phase 7. The scrape interval in seconds. Default 60.",
          "type": "integer",
          "minimum": 15,
          "maximum": 3600
        }
      }
    },
    "security": {
      "description": "Phase 7. The hardening options (docs/console-server.md, section 13).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "firewall": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "policy": {
              "description": "The input policy of the table inet care-pi. accept (default, S42) or drop (only the allow-list). A switch to drop starts a 90 s rollback timer: care-pi firewall confirm keeps it.",
              "enum": ["accept", "drop"]
            }
          }
        },
        "ssh": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allow": {
              "description": "Accept 22/tcp in the firewall. It matters only with the policy drop. Default true.",
              "type": "boolean"
            }
          }
        },
        "waf": {
          "description": "Phase 7. The optional Coraza WAF with the OWASP CRS on the routes of the Care API (/api/* and the other Django paths). Off by default: expect false positives (file uploads, rich text). Needs the care-pi Caddy image with the Coraza module.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "mode": {
              "description": "detect: log only (SecRuleEngine DetectionOnly; default). block: deny a request over the anomaly threshold with 403.",
              "enum": ["detect", "block"]
            },
            "paranoia": {
              "description": "The paranoia level of the CRS (1 to 4). Default 1.",
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            }
          }
        }
      }
    }
  },
  "$defs": {
    "dnsLabel": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "ref": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/:@+-]{0,199}$"
    },
    "image": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/:@-]*[A-Za-z0-9_.-]$",
      "maxLength": 512
    },
    "envValue": {
      "type": "string",
      "pattern": "^[^\\r\\n]*$"
    },
    "calendar": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9 :*,./-]+$"
    },
    "clockTime": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "plugCustom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$" },
        "enabled": { "type": "boolean" },
        "backend": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
            "package": { "type": "string", "minLength": 1, "pattern": "^[^\\s]+$" },
            "ref": { "type": "string", "$ref": "#/$defs/ref" },
            "configs": { "type": "object" }
          }
        },
        "frontend": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repo": { "type": "string", "pattern": "^https://[^\\s]+$" },
            "ref": { "type": "string", "$ref": "#/$defs/ref" },
            "url": { "type": "string", "pattern": "^https://[^\\s]+$" }
          }
        }
      }
    },
    "plugChoice": {
      "description": "Phase 4. The operator choice for one plug of the solution.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "description": "true or false: the operator turns the plug on or off. null or absent: the default of the solution and its auto rule apply.",
          "type": ["boolean", "null"]
        },
        "settings": {
          "description": "The values of the settings form, by part and by setting key (solution.yaml plugs[].settings[].key). A value of type secret is never here.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "backend": {
              "description": "The values of the settings with part backend. They go into configs of the ADDITIONAL_PLUGS entry.",
              "type": "object",
              "propertyNames": { "minLength": 1, "maxLength": 200 }
            },
            "frontend": {
              "description": "The values of the settings with part frontend. The key is a dotted path in meta of the plug_config row.",
              "type": "object",
              "propertyNames": { "minLength": 1, "maxLength": 200 }
            }
          }
        }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,30}$" },
        "type": { "enum": ["posix", "sftp", "s3"] },
        "path": { "type": "string", "pattern": "^/[^\\s]*$" },
        "host": { "type": "string", "minLength": 1, "pattern": "^[^\\s/]+$" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "user": { "type": "string", "minLength": 1, "pattern": "^[^\\s@]+$" },
        "endpoint": { "type": "string", "pattern": "^https?://[^\\s]+$" },
        "bucket": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$" },
        "region": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" },
        "disk_label": {
          "description": "posix: the label of a disk that care-pi prepared. The agent mounts it at /var/lib/care-pi/disks/<label>. Use path or disk_label, not both.",
          "type": "string",
          "pattern": "^care-[a-z0-9][a-z0-9-]{0,10}$"
        },
        "host_key": {
          "description": "sftp: the pinned host key of the server (key type and base64, as in known_hosts). The destination test returns it at the first contact.",
          "type": "string",
          "maxLength": 1024,
          "pattern": "^(ssh-ed25519|ecdsa-sha2-nistp256|ecdsa-sha2-nistp384|ecdsa-sha2-nistp521|ssh-rsa) [A-Za-z0-9+/]+={0,2}$"
        },
        "prefix": {
          "description": "s3: a key prefix inside the bucket, without a slash at the start or at the end.",
          "type": "string",
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
        },
        "interval_min": {
          "description": "Minutes between two snapshots of the local database repository to this destination.",
          "type": "integer",
          "minimum": 5,
          "maximum": 1440
        },
        "retention": { "$ref": "#/$defs/destinationRetention" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "posix" } } },
          "then": { "oneOf": [{ "required": ["path"] }, { "required": ["disk_label"] }] }
        },
        {
          "if": { "properties": { "type": { "const": "sftp" } } },
          "then": { "required": ["host", "user", "path"] }
        },
        {
          "if": { "properties": { "type": { "const": "s3" } } },
          "then": { "required": ["endpoint", "bucket"] }
        }
      ]
    },
    "destinationRetention": {
      "description": "The restic forget policy of one destination. A key that is not there gets its default.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keep_within_days": { "type": "integer", "minimum": 0, "maximum": 3650 },
        "keep_daily": { "type": "integer", "minimum": 0, "maximum": 3650 },
        "keep_weekly": { "type": "integer", "minimum": 0, "maximum": 520 },
        "keep_monthly": { "type": "integer", "minimum": 0, "maximum": 120 }
      }
    }
  }
}
